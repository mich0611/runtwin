DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=0
# Include the public hostname used by STRAVA_WEBHOOK_CALLBACK_URL.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Docker Compose requires POSTGRES_PASSWORD and DJANGO_SECRET_KEY. Leave DATABASE_URL empty for local SQLite.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=
RUNTWIN_PROVIDER=snapshot
RUNTWIN_EXPORT_DIR=/app/runtime/exports
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=0
RUNTWIN_ADMIN_USERNAME=runner
RUNTWIN_ADMIN_PASSWORD=replace-with-a-long-random-password
RUNTWIN_ADMIN_EMAIL=
# Optional LLM analysis. Leave RUNTWIN_AI_PROVIDER empty to use deterministic analysis only.
#   anthropic -> needs ANTHROPIC_API_KEY  (https://console.anthropic.com/)  default model claude-opus-5-5
#   openai    -> needs OPENAI_API_KEY     (https://platform.openai.com/)    default model gpt-6.2-astra
RUNTWIN_AI_PROVIDER=
# Leave empty to use the provider default above.
RUNTWIN_AI_MODEL=
# Reasoning effort passed to the model: low | medium | high
RUNTWIN_AI_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Marker that wraps the analysis block in each Strava description.
RUNTWIN_ANALYSIS_LABEL=RunTwin analysis
# Comma-separated old labels to replace when re-publishing (only needed if you changed the label).
RUNTWIN_LEGACY_ANALYSIS_LABELS=
# Optional Garmin supplementary metrics (unofficial API). Tokens come from garmin-mcp-auth; failures never block analysis.
RUNTWIN_GARMIN_ENABLED=0
RUNTWIN_GARMIN_TOKEN_DIR=~/.garminconnect
# Dedicated personal Strava OAuth app; authorize with activity:read_all,activity:write.
# Use activity:read_all instead of activity:read when publishing Only Me activities.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_TOKEN_FILE=/app/runtime/strava-token.json
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
# Generate two independent random values (at least 32 bytes each).
STRAVA_WEBHOOK_PATH_TOKEN=replace-with-a-long-random-url-token
STRAVA_WEBHOOK_CALLBACK_URL=https://your-domain.example/webhooks/strava/replace-with-a-long-random-url-token
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-with-another-long-random-value
# Signature support is optional until Strava formally exposes a signing secret.
STRAVA_WEBHOOK_SIGNING_SECRET=
STRAVA_WEBHOOK_REQUIRE_SIGNATURE=0
STRAVA_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# Optional defense-in-depth: set these after subscription/OAuth setup.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
STRAVA_ATHLETE_ID=
STRAVA_WEBHOOK_POLL_SECONDS=10
STRAVA_WEBHOOK_MAX_ATTEMPTS=3
STRAVA_WEBHOOK_PROCESSING_TIMEOUT_SECONDS=1800
STRAVA_RECONCILE_INTERVAL_SECONDS=3600
STRAVA_RECONCILE_DAYS=14
